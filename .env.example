# Airtable API key (required)
# Get from: https://airtable.com/create/tokens
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX

# Path to JSON file containing X / Twitter session cookies (required for X posts)
# Export with the "Cookie-Editor" browser extension while logged into x.com
# Save the exported JSON as x_cookies.json (or change this path)
X_COOKIES_FILE=x_cookies.json

# Path to JSON file containing LinkedIn session cookies (required for LinkedIn posts)
# Export with the "Cookie-Editor" browser extension while logged into linkedin.com
LINKEDIN_COOKIES_FILE=linkedin_cookies.json

# Optional: override the Chromium binary used by Playwright
# Default: /opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chrome
